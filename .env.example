# --- WordPress (Headless) ---
# Once WP is live, set this to e.g. https://api.gbdoner.com/graphql
NEXT_PUBLIC_WORDPRESS_GRAPHQL_URL=

# Set to "true" while WP is not yet configured to serve UI from local mocks.
NEXT_PUBLIC_USE_MOCK_DATA=true

# ISR revalidate window (seconds). 60 = fresh within a minute of WP edits.
WORDPRESS_REVALIDATE_SECONDS=60

# --- Mapbox ---
# Get a public token from https://account.mapbox.com/
NEXT_PUBLIC_MAPBOX_TOKEN=

# --- Site ---
NEXT_PUBLIC_SITE_URL=https://gbdoner.com
