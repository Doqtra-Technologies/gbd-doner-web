# ==============================================================================
# GBD Doner Frontend - Environment Configuration Template
# ==============================================================================

# 1. Primary Public Domain config (No trailing slash)
# Set this to your chosen primary domain. All other 13 domains should redirect
# to this domain at the DNS/CDN/Hosting level (e.g. on Vercel or Cloudflare).
# This prevents duplicate content issues and keeps SEO strong.
NEXT_PUBLIC_SITE_URL=https://greatbritishdoner.com

# 2. Headless WordPress Connection
# Points to your WordPress GraphQL endpoint
NEXT_PUBLIC_WORDPRESS_GRAPHQL_URL=https://api.greatbritishdoner.com/graphql
NEXT_PUBLIC_USE_MOCK_DATA=false

# 3. ISR & Revalidation
# Control how long Next.js caches page requests (in seconds)
WORDPRESS_REVALIDATE_SECONDS=60
# Secret key to authenticate on-publish webhook revalidation from WordPress.
# Must match the GBD_REVALIDATE_SECRET defined in wp-config.php on your WP server.
WORDPRESS_REVALIDATE_SECRET=9f3c8b72da104b28ae5f63d09a067e81

# 4. Preview / Draft Secret
# Secret key to authenticate WP admin preview mode drafts.
# Must match the GBD_PREVIEW_SECRET defined in wp-config.php on your WP server.
WORDPRESS_PREVIEW_SECRET=e2d67fa361cb48b29f04dce85bc19a0a

# 5. Outgoing Mail Setup (SMTP for Enquiry/Catering/Franchise Forms)
# Setup your mail delivery provider (e.g. SendGrid, Mailgun, AWS SES, Gmail)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=apikey
SMTP_PASS=your-smtp-api-password-or-key
SMTP_FROM=noreply@greatbritishdoner.com

# 6. Enquiry Recipients
# Destination email addresses for Catering and Franchise form submissions.
CATERING_EMAIL_TO=info@gbddoner.com
FRANCHISE_EMAIL_TO=franchise@gbddoner.com
